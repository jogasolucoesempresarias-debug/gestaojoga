# Gestão JOGA — template de variáveis de ambiente
# Copie este arquivo pra `.env` (local) ou cadastre cada variável no Portainer (prod).
# NUNCA commitar o `.env` com valores reais.

# ── Flask ──
# Gerar com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-essa-chave-em-prod

# ── PostgreSQL ──
# Local: Postgres da máquina (banco separado do multpel_db).
# Prod:  DB_HOST=postgres_postgres (serviço compartilhado no Swarm).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gestao_joga
DB_USER=postgres
DB_PASSWORD=

# ── Senha inicial dos usuários semeados (trocada no 1º login) ──
SEED_SENHA_INICIAL=joga123

# ── Agente de IA Comercial (OpenAI) ──
# Sem a chave, o agente roda em MODO MOCK (testa o fluxo sem custo).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
